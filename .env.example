NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
# Preferred: a bcrypt hash generated with `node scripts/hash-password.js <password>`.
# Required in production — plaintext ADMIN_PASSWORD below is refused there.
ADMIN_PASSWORD_HASH=
# Development-only fallback. Never set this in production.
ADMIN_PASSWORD=replace-me
ALLOWED_TARGETS=example1.com,example2.com
# Domains considered pre-verified without needing DNS TXT / .well-known proof.
# Keep only targets whose ownership and written authorization you have confirmed.
# DNS TXT and .well-known verification (POST /api/targets/verify) is also
# available for any domain in ALLOWED_TARGETS and persists to the database.
SERVER_ALLOWLIST_VERIFIED_TARGETS=example1.com,example2.com
ALLOW_PRIVATE_TARGETS=false
ALLOWED_IP_TARGETS=
ALLOW_HIGH_LOAD=false
MAX_ALLOWED_RPS=1000
# RPS at/above which the admin must retype the exact domain and RPS to confirm.
HIGH_LOAD_CONFIRMATION_THRESHOLD=10000
# RPS at/above which local execution is always blocked and a distributed
# provider is required. No single machine can honestly generate this much load.
DISTRIBUTED_REQUIRED_THRESHOLD=1000000
MAX_TEST_DURATION_SECONDS=3600
COOLDOWN_SECONDS=60
MAX_ERROR_RATE=0.05
MAX_P95_MS=1000
MAX_BAD_STATUS_RATE=0.05
MAX_CONCURRENT_HIGH_LOAD=1
DISTRIBUTED_PROVIDER=
# Base64-encoded 32-byte key generated with `node scripts/generate-secrets-key.js`.
# Required before any literal (non-$env:) request secret can be stored, in
# production. Without it, prefer auth.secretEnv / header values shaped like
# $env:VAR_NAME, which are never persisted at all.
SECRETS_ENCRYPTION_KEY=
DATABASE_PATH=./data/rps-load-tester.sqlite
K6_BINARY=k6
TRUST_PROXY=false

# Used only with docker-compose.limits.yml. The default compose file has no
# per-container CPU/RAM cap and uses resources assigned to Docker Engine.
LOADGEN_CPU_LIMIT=2.0
LOADGEN_MEMORY_LIMIT=2G
LOADGEN_MEMORY_RESERVATION=256M

# Example request secrets. Replace locally; never commit actual values.
BASIC_API_PASSWORD=
STUDENT_API_TOKEN=
